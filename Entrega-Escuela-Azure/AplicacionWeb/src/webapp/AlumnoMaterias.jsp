<%@ page import="org.gerdoc.service.*" %><%@ page import="org.gerdoc.service.impl.*" %><%@ page import="org.gerdoc.model.*" %><%@ page import="java.util.*" %><%@ page contentType="text/html;charset=UTF-8" %>
<% AlumnoMateriaService relService=new AlumnoMateriaServiceImpl(); AlumnoService alumnoService=new AlumnoServiceImpl(); MateriaService materiaService=new MateriaServiceImpl(); List<AlumnoMateria> relaciones=relService.findAll(); List<Alumno> alumnos=alumnoService.findAll(); List<Materia> materias=materiaService.findAll(); %>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Alumno - Materia</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"></head><body><main class="container py-4"><h1>Relación Alumno - Materia</h1><p class="text-secondary">Inscripción de alumnos a materias y registro de calificaciones.</p>
<button class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#modalRel" onclick="nuevo()">Agregar relación</button>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>ID</th><th>Alumno</th><th>Materia</th><th>Calificación</th><th>Acciones</th></tr></thead><tbody>
<% for(AlumnoMateria r:relaciones){ %><tr><td><%=r.getId()%></td><td><%=r.getAlumno().getNombre()%></td><td><%=r.getMateria().getNombre()%></td><td><%=r.getCalificacion()==null?"Sin calificar":r.getCalificacion()%></td><td><button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalRel" onclick="editar('<%=r.getId()%>','<%=r.getAlumno().getId()%>','<%=r.getMateria().getId()%>','<%=r.getCalificacion()==null?"":r.getCalificacion()%>')">Editar</button> <form action="AlumnoMateriaServlet" method="post" class="d-inline"><input type="hidden" name="accion" value="delete"><input type="hidden" name="id" value="<%=r.getId()%>"><button class="btn btn-danger btn-sm" onclick="return confirm('¿Eliminar esta relación?')">Eliminar</button></form></td></tr><% } %>
</tbody></table></div><a href="index.jsp" class="btn btn-secondary">Inicio</a></main>
<div class="modal fade" id="modalRel" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form action="AlumnoMateriaServlet" method="post" id="formRel"><div class="modal-header"><h5 class="modal-title" id="titulo">Agregar relación</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="id" id="id"><input type="hidden" name="accion" id="accion" value="save"><label class="form-label">Alumno</label><select class="form-select mb-3" name="alumnoId" id="alumnoId" required><option value="">Selecciona alumno</option><% for(Alumno a:alumnos){ %><option value="<%=a.getId()%>"><%=a.getNombre()%></option><% } %></select><label class="form-label">Materia</label><select class="form-select mb-3" name="materiaId" id="materiaId" required><option value="">Selecciona materia</option><% for(Materia m:materias){ %><option value="<%=m.getId()%>"><%=m.getNombre()%></option><% } %></select><label class="form-label">Calificación (opcional)</label><input class="form-control" type="number" min="0" max="10" step="0.01" name="calificacion" id="calificacion"></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="submit">Guardar</button></div></form></div></div></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script><script>function nuevo(){document.getElementById('formRel').reset();document.getElementById('id').value='';document.getElementById('accion').value='save';document.getElementById('titulo').textContent='Agregar relación';}function editar(id,a,m,c){document.getElementById('id').value=id;document.getElementById('alumnoId').value=a;document.getElementById('materiaId').value=m;document.getElementById('calificacion').value=c;document.getElementById('accion').value='update';document.getElementById('titulo').textContent='Editar relación';}</script></body></html>